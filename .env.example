
# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Provider priority
LLM_PROVIDER_ORDER=gemini,groq,openrouter

# Application configuration
APP_ENV=development
LOG_LEVEL=INFO

# General LLM configuration
LLM_TIMEOUT_SECONDS=30
